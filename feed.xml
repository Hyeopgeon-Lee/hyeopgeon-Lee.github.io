---
layout: null
permalink: /feed.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
<channel>
<title>{{ site.title | xml_escape }} 기술 블로그</title>
<link>{{ '/blog/' | absolute_url }}</link>
<description>{{ site.description | xml_escape }}</description>
<language>ko-KR</language>
<atom:link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/rss+xml"/>
{% for post in site.posts %}{% unless post.noindex or post.sitemap == false %}
<item>
<title>{{ post.title | xml_escape }}</title>
<link>{{ post.url | absolute_url | xml_escape }}</link>
<guid isPermaLink="true">{{ post.url | absolute_url | xml_escape }}</guid>
<pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
<description>{{ post.description | default: post.excerpt | strip_html | xml_escape }}</description>
<content:encoded>{{ post.content | xml_escape }}</content:encoded>
</item>
{% endunless %}{% endfor %}
</channel>
</rss>
